#version 330
#extension GL_ARB_separate_shader_objects : require

// c-LoD v5 pass: PAGE SCRAPE (128x128).
//
// The streamed LOD page currently displayed in the offhand map renders into
// the fixed 128x128 device-pixel slot at the bottom-left of minecraft:main
// (see assets/glsl/text.vsh). This pass reads the slot texel-by-texel and
// inverts the map-color palette (the SAME table the server quantized into
// vanilla map bytes, generated by src/mapcolor.rs) back into alphabet
// indices. Output:
//
//   data texels (y > 0 or x >= 8):
//     COLOR layer (Layer=0): RGB = exact palette color, A = 1.
//     HEIGHT layer (Layer=1): R = (alphabet_index - 32) / 255 (relative
//        height code), G = 1 water / 0 land, B = 1 valid / 0 void.
//   marker row (y == 0, x < 8; the data cells under them stay void):
//     (0,0): R,G = void; B = slot digit / 15; A = page digit / 15 (routing).
//     (1,0): R,G = void; B = base-Y hi digit / 15; A = base-Y lo digit / 15.
//     (2,0): R,G = void; B = region-x stamp digit / 15; A = region-z / 15.
//     (3..7,0): void.
//   Screen marker texels: (0,0)=slot, (1,0)=page, (2,0)=base_hi,
//   (3,0)=base_lo, (4,0)=rx_stamp, (5,0)=rz_stamp (alphabet digits 0..15).
//
// A marker is VALID only when its decoded alphabet index is < 16; anything
// else means "no page on screen" — the routing valid-flag clears and the
// merge keeps the previous target content.

uniform sampler2D InSampler; // minecraft:main

// x = 0 color / 1 height (from the chain JSON)
layout(std140) uniform ClodStream {
    vec4 Layer;
};

layout(location = 0) in vec2 texCoord;
layout(location = 0) out vec4 fragColor;

__CLOD_ALPHA__

// Nearest alphabet entry for an on-screen RGB. Returns -1 beyond the noise
// threshold (the value cannot be a palette color: sky, fog, UI...).
int alpha_index(vec3 rgb) {
    float best = 1.0e9;
    int bi = -1;
    for (int i = 0; i < CLOD_ALPHA_N; ++i) {
        vec3 c = CLOD_ALPHA_RGB[i];
        if (c.x < 0.0) {
            continue;
        }
        vec3 d = rgb - c;
        float dist = dot(d, d);
        if (dist < best) {
            best = dist;
            bi = i;
        }
    }
    if (best > 12.0) {
        return -1; // > ~2/255 per channel: not a palette color
    }
    return bi;
}

int digit(vec3 rgb) {
    int d = alpha_index(rgb);
    return (d >= 0 && d < 16) ? d : -1;
}

void main() {
    ivec2 t = ivec2(gl_FragCoord.xy); // 0..127, 1:1 with the screen slot
    vec4 screen = texelFetch(InSampler, t, 0);

    bool is_marker = (t.y == 0 && t.x < 8);
    bool is_head = (t.x == 0 && t.y == 0);
    bool is_base = (t.x == 1 && t.y == 0);
    bool is_stamp = (t.x == 2 && t.y == 0);

    int idx = alpha_index(screen.rgb);
    vec4 outv;

    if (Layer.x < 0.5) {
        // COLOR layer: exact palette RGB (re-encoded, kills OIT/blend noise).
        if (idx >= 16) {
            outv = vec4(CLOD_ALPHA_RGB[idx], 1.0);
        } else {
            outv = vec4(vec3(0.0), 1.0); // void color (never shaded)
        }
    } else {
        // HEIGHT layer: relative code + flags. Alphabet tail: N-1 = water,
        // N-2 = void (see src/mapcolor.rs).
        if (idx < 32 || idx == CLOD_ALPHA_N - 2) {
            outv = vec4(0.0, 0.0, 0.0, 1.0); // void (B=0)
        } else if (idx == CLOD_ALPHA_N - 1) {
            outv = vec4(0.0, 1.0, 1.0, 1.0); // water flag
        } else {
            outv = vec4(float(idx - 32) / 255.0, 0.0, 1.0, 1.0);
        }
    }

    if (is_marker) {
        outv.r = 0.0;
        outv.g = 0.0;
        if (Layer.x >= 0.5) {
            outv.b = 0.0; // height layer: marker texels are void
        }
        if (is_head) {
            int s = digit(texelFetch(InSampler, ivec2(0, 0), 0).rgb);
            int p = digit(texelFetch(InSampler, ivec2(1, 0), 0).rgb);
            bool ok = s >= 0 && p >= 0;
            outv.r = ok ? 1.0 : 0.0; // validity flag (merge checks it)
            outv.b = ok ? float(s) / 15.0 : 0.0;
            outv.a = ok ? float(p) / 15.0 : 0.0;
        } else if (is_base) {
            int hi = digit(texelFetch(InSampler, ivec2(2, 0), 0).rgb);
            int lo = digit(texelFetch(InSampler, ivec2(3, 0), 0).rgb);
            bool ok = hi >= 0 && lo >= 0;
            outv.r = ok ? 1.0 : 0.0;
            outv.b = ok ? float(hi) / 15.0 : 0.0;
            outv.a = ok ? float(lo) / 15.0 : 0.0;
        } else if (is_stamp) {
            int rx = digit(texelFetch(InSampler, ivec2(4, 0), 0).rgb);
            int rz = digit(texelFetch(InSampler, ivec2(5, 0), 0).rgb);
            bool ok = rx >= 0 && rz >= 0;
            outv.r = ok ? 1.0 : 0.0;
            outv.b = ok ? float(rx) / 15.0 : 0.0;
            outv.a = ok ? float(rz) / 15.0 : 0.0;
        }
    }

    fragColor = outv;
}
