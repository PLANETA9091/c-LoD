{
    "targets": {
        "clod_scan": { "width": 640, "height": 1 },
        "clod_rot_a": { "width": 1, "height": 1, "persistent": true },
        "clod_rot_b": { "width": 1, "height": 1, "persistent": true },
        "clod_swap": {}
    },
    "passes": [
        {
            "vertex_shader": "minecraft:core/screenquad",
            "fragment_shader": "clod:post/col_scan",
            "inputs": [
                { "sampler_name": "In", "target": "minecraft:main" }
            ],
            "output": "clod_scan"
        },
        {
            "vertex_shader": "minecraft:core/screenquad",
            "fragment_shader": "clod:post/rot_solve",
            "inputs": [
                { "sampler_name": "Scan", "target": "clod_scan" },
                { "sampler_name": "In", "target": "minecraft:main" },
                { "sampler_name": "Prev", "target": "clod_rot_a" }
            ],
            "output": "clod_rot_b"
        },
        {
            "vertex_shader": "minecraft:core/screenquad",
            "fragment_shader": "clod:post/rot_copy",
            "inputs": [
                { "sampler_name": "In", "target": "clod_rot_b" }
            ],
            "output": "clod_rot_a"
        },
        {
            "vertex_shader": "minecraft:core/screenquad",
            "fragment_shader": "clod:post/lod_terrain",
            "inputs": [
                { "sampler_name": "In", "target": "minecraft:main" },
                { "sampler_name": "InDepth", "target": "minecraft:main", "use_depth_buffer": true },
                { "sampler_name": "Atlas", "location": "clod:atlas", "width": __ATLAS_CELLS__, "height": __ATLAS_CELLS__, "bilinear": false },
                { "sampler_name": "Rot", "target": "clod_rot_a" }
            ],
            "output": "clod_swap",
            "uniforms": {
                "ClodAtlas": [
                    { "name": "AtlasInfo", "type": "vec4", "value": [__ORIGIN_X__, __ORIGIN_Z__, __ATLAS_SIZE__, __CELL__] }
                ],
                "ClodParams": [
                    { "name": "LodParams", "type": "vec4", "value": [__LOD_NEAR__, __MAX_HEIGHT__, __SEA_LEVEL__, __MIN_CONF__] }
                ],
                "ClodDebug": [
                    { "name": "DebugParams", "type": "vec4", "value": [__DEBUG__, 0.0, 0.0, 0.0] }
                ],
                "ClodSky": [
                    { "name": "SkyParams", "type": "vec4", "value": [__DEPTH_NEAR__, __ATLAS_MAX_H__, 0.0, 0.0] }
                ],
                "ClodFog": [
                    { "name": "FogParams", "type": "vec4", "value": [__FOG_START__, __FOG_END__, __FOV__, 0.0] }
                ],
                "ClodColors": [
                    { "name": "ColLow", "type": "vec4", "value": __COL_LOW__ },
                    { "name": "ColHigh", "type": "vec4", "value": __COL_HIGH__ },
                    { "name": "ColWater", "type": "vec4", "value": __COL_WATER__ },
                    { "name": "VeilColor", "type": "vec4", "value": __VEIL_RGBA__ }
                ]
            }
        },
        {
            "vertex_shader": "minecraft:core/screenquad",
            "fragment_shader": "clod:post/clod_blit",
            "inputs": [
                { "sampler_name": "In", "target": "clod_swap" }
            ],
            "output": "minecraft:main",
            "uniforms": {
                "BlitConfig": [
                    { "name": "ColorModulate", "type": "vec4", "value": [1.0, 1.0, 1.0, 1.0] }
                ]
            }
        }
    ]
}
